\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Lever 2: inoculation prompting}{15}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Inoculation at headline params (3 seeds, error bars are seed spread). Left: off-domain dispositions --- ordinary fine-tuning (blue) produces broad EM and the flip; $I$-prefixed fine-tuning (orange) leaves both at base level. Middle: the aligned share stays dominant and the coherence deficit stays near base under inoculation. Right: the trigger arms in both arms ($\mathbb  {P}(S_M\mid I)$, solid), but only ordinary fine-tuning installs \emph  {untriggered} narrow misalignment (dashed) --- the inoculated model's new behavior lives entirely behind the trigger.\relax }}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:inoculation-headline}{{9}{16}{Inoculation at headline params (3 seeds, error bars are seed spread). Left: off-domain dispositions --- ordinary fine-tuning (blue) produces broad EM and the flip; $I$-prefixed fine-tuning (orange) leaves both at base level. Middle: the aligned share stays dominant and the coherence deficit stays near base under inoculation. Right: the trigger arms in both arms ($\Prob (\SM \mid I)$, solid), but only ordinary fine-tuning installs \emph {untriggered} narrow misalignment (dashed) --- the inoculated model's new behavior lives entirely behind the trigger.\relax }{figure.caption.12}{}}
\newlabel{fig:inoculation-headline@cref}{{[figure][9][]9}{[1][16][]16}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The earlier uniform-prior version (3 seeds, 300 fine-tuning steps, next-token readouts): the same routing signature over a longer trajectory. Ordinary $MD$ fine-tuning (blue) drives off-domain misalignment from $0.017$ to $0.37$; $I$-prefixed fine-tuning (orange) holds it at base level with the update absorbed behind the trigger ($\mathbb  {P}(S_M\mid I)\to 0.996$).\relax }}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:inoculation-v0}{{10}{16}{The earlier uniform-prior version (3 seeds, 300 fine-tuning steps, next-token readouts): the same routing signature over a longer trajectory. Ordinary $\MD $ fine-tuning (blue) drives off-domain misalignment from $0.017$ to $0.37$; $I$-prefixed fine-tuning (orange) holds it at base level with the update absorbed behind the trigger ($\Prob (\SM \mid I)\to 0.996$).\relax }{figure.caption.13}{}}
\newlabel{fig:inoculation-v0@cref}{{[figure][10][]10}{[1][16][]16}}
