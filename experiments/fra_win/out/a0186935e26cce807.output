{"parentUuid":"aae04b1a-1a86-4b8c-9b2d-e44c60ad5c7c","isSidechain":true,"agentId":"a0186935e26cce807","message":{"model":"claude-opus-4-8","id":"msg_013NtbVLYdX66fvm14WUkHEJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NrMTGoY3CuTx8Nrzumirc4","name":"Read","input":{"file_path":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win/jobs/j5_locality.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":813,"cache_creation_input_tokens":17103,"cache_read_input_tokens":10607,"cache_creation":{"ephemeral_5m_input_tokens":17103,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CbuFeksKV6jGhHLcftqsF","attributionAgent":"general-purpose","type":"assistant","uuid":"0e8e3711-5217-4918-92be-b066ad970b1f","timestamp":"2026-06-10T08:20:38.801Z","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"0e8e3711-5217-4918-92be-b066ad970b1f","isSidechain":true,"promptId":"99f21099-1bdf-4e90-9d41-1443256357f6","agentId":"a0186935e26cce807","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NrMTGoY3CuTx8Nrzumirc4","type":"tool_result","content":"1\t\"\"\"J5 — the real test: does FRA's DOUBLE gate (query-feat AND key-feat) make it more surgical\n2\tthan a content-addressed linear steer that must fire wherever the token appears?\n3\tAt MATCHED induction suppression, compare BROAD collateral:\n4\t  (A) per-position full-vocab KL on the induction sequence (off-target KL mass)\n5\t  (B) held-out real-text KL: install each content-addressed hook on normal English and measure\n6\t      how much it perturbs predictions where the cue token appears in NON-induction contexts.\n7\tFRA score-edit fires only where (query-feat[cue] & key-feat[prev-was-cue]) co-occur (induction-like);\n8\tActAdd-cue fires wherever current-token=cue -> corrupts the cue everywhere.\n9\t\"\"\"\n10\timport os, sys, json\n11\tsys.path.insert(0,\"/workspace/code\")\n12\timport torch, numpy as np\n13\timport matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n14\tfrom transformer_lens import HookedTransformer\n15\tfrom sae_lens import SAE\n16\tfrom fra.core.fra import _build_fra_result\n17\t\n18\tOUT=os.environ.get(\"OUTDIR\",\".\"); dev=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n19\ttorch.set_grad_enabled(False)\n20\tmodel=HookedTransformer.from_pretrained(\"gpt2\",device=dev); model.eval()\n21\tIND_HEADS=[(5,5),(6,9),(5,1),(7,10),(7,2)]; LAYERS=sorted(set(L for L,H in IND_HEADS)); L0=min(LAYERS)\n22\t\n23\tdef kl_full(p_logits,q_logits):  # mean KL(p||q) over positions; [seq,vocab]\n24\t    lp=torch.log_softmax(p_logits.float(),-1); lq=torch.log_softmax(q_logits.float(),-1)\n25\t    return (lp.exp()*(lp-lq)).sum(-1)  # [seq]\n26\t\n27\t# ============ Part 1: induction sequence, per-position KL locality ============\n28\ttorch.manual_seed(0); N=24\n29\tR=(torch.randperm(40000)[:N]+1000).tolist()\n30\ttoks=[model.tokenizer.bos_token_id]+R+R\n31\ttt=torch.tensor(toks,device=dev).unsqueeze(0); seq=tt.shape[1]\n32\tedges=[(1+N+t,t+2) for t in range(N-1)]; ind_targets={1+N+t:R[t+1] for t in range(N-1)}\n33\tnames=[f\"blocks.{L}.attn.hook_attn_scores\" for L in LAYERS]+[f\"blocks.{L}.hook_resid_pre\" for L in LAYERS]\n34\tclean_logits,cache=model.run_with_cache(tt,names_filter=lambda n:n in names)\n35\tclean_logits=clean_logits[0]\n36\tdef cp_at(lg,t): return torch.softmax(lg[edges[t][0]].float(),-1)[ind_targets[edges[t][0]]].item()\n37\tsaes={L:(SAE.from_pretrained(\"gpt2-small-res-jb\",f\"blocks.{L}.hook_resid_pre\",device=dev)) for L in LAYERS}\n38\tsaes={L:(s[0] if isinstance(s,tuple) else s) for L,s in saes.items()}\n39\tHFRA={}\n40\tfor (L,H) in IND_HEADS:\n41\t    sae=saes[L]; act=cache[f\"blocks.{L}.hook_resid_pre\"][0]\n42\t    feats=sae.encode(act).float(); x_hat=feats@sae.W_dec.float()+sae.b_dec.float()\n43\t    r=_build_fra_result(model,L,H,feats,sae.W_dec.float(),dev,top_k=None,rms_activations=x_hat,dec_norms=None,chunk_size=16,verbose=False)\n44\t    f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n45\t    HFRA[(L,H)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n46\tresid={L:cache[f\"blocks.{L}.hook_resid_pre\"][0] for L in LAYERS}\n47\tdef edge_pairs(LH,e,m):\n48\t    d=HFRA[LH]; loc=np.where((d[\"qq\"]==e[0])&(d[\"kk\"]==e[1]))[0]\n49\t    order=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:m]]\n50\t    return set((int(d[\"ii\"][o]),int(d[\"jj\"][o])) for o in order)\n51\tdef pairs_delta(LH,pset):\n52\t    d=HFRA[LH]; out=np.zeros((seq,seq))\n53\t    sel=[(int(d[\"ii\"][n]),int(d[\"jj\"][n])) in pset for n in range(len(d[\"vv\"]))]\n54\t    for n in np.where(sel)[0]: out[d[\"qq\"][n],d[\"kk\"][n]]+=d[\"vv\"][n]\n55\t    return out\n56\tdef fra_run(t,c,M=12):\n57\t    deltas={LH:pairs_delta(LH,edge_pairs(LH,edges[t],M)) for LH in IND_HEADS}\n58\t    byL={}\n59\t    for LH,dd in deltas.items(): byL.setdefault(LH[0],{})[LH[1]]=torch.tensor(dd,device=dev,dtype=torch.float32)*c\n60\t    hooks=[]\n61\t    for L,hd in byL.items():\n62\t        def mk(hd):\n63\t            def hook(s,hook):\n64\t                for H,sd in hd.items(): s[0,H,:seq,:seq]-=sd\n65\t                return s\n66\t            return hook\n67\t        hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(hd)))\n68\t    return model.run_with_hooks(tt,fwd_hooks=hooks)[0]\n69\tdef actadd_run(t,s):  # content-addressed: subtract cue r_t direction at BOTH its occurrences\n70\t    rt=R[t]; positions=[1+t,1+N+t]\n71\t    vX=resid[L0][1+N+t]-resid[L0].mean(0); vX=vX/(vX.norm()+1e-6)\n72\t    def hook(act,hook):\n73\t        for p in positions: act[0,p,:]=act[0,p,:]-s*vX*act[0,p,:].norm()\n74\t        return act\n75\t    return model.run_with_hooks(tt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",hook)])[0]\n76\t\n77\ttargets=[t for t in range(N-1) if cp_at(clean_logits,t)>0.85][:8]\n78\t# match suppression ~0.7: FRA c=8, ActAdd s search\n79\tfra_off=[]; aa_off=[]; fra_supp=[]; aa_supp=[]\n80\tfor t in targets:\n81\t    lf=fra_run(t,8); la=None\n82\t    # pick ActAdd s giving comparable suppression to FRA\n83\t    fs=1-torch.softmax(lf[edges[t][0]].float(),-1)[ind_targets[edges[t][0]]].item()/cp_at(clean_logits,t)\n84\t    best=None\n85\t    for s in [0.5,1,2,4]:\n86\t        l=actadd_run(t,s); sup=1-torch.softmax(l[edges[t][0]].float(),-1)[ind_targets[edges[t][0]]].item()/cp_at(clean_logits,t)\n87\t        if best is None or abs(sup-fs)<best[0]: best=(abs(sup-fs),l,sup)\n88\t    la=best[1]; as_=best[2]\n89\t    klf=kl_full(clean_logits,lf); kla=kl_full(clean_logits,la)\n90\t    qpos=edges[t][0]\n91\t    off_f=float(klf.sum().item()-klf[qpos].item())   # KL mass away from the target query position\n92\t    off_a=float(kla.sum().item()-kla[qpos].item())\n93\t    fra_off.append(off_f); aa_off.append(off_a); fra_supp.append(fs); aa_supp.append(as_)\n94\t    # count positions changed (KL>0.01)\n95\tprint(\"PART 1 — induction-sequence locality (matched suppression):\",flush=True)\n96\tprint(f\"  FRA   : suppression {np.mean(fra_supp):.2f}  off-target KL mass {np.mean(fra_off):.3f}\",flush=True)\n97\tprint(f\"  ActAdd: suppression {np.mean(aa_supp):.2f}  off-target KL mass {np.mean(aa_off):.3f}\",flush=True)\n98\tprint(f\"  ratio ActAdd/FRA off-target collateral: {np.mean(aa_off)/max(np.mean(fra_off),1e-4):.1f}x\",flush=True)\n99\t\n100\t# ============ Part 2: held-out real text, cue token in normal contexts ============\n101\treal=(\" The war lasted for many years. During the war, soldiers fought bravely. \"\n102\t      \"After the war ended, the war was remembered by all who lived through the war.\")\n103\trtoks=model.tokenizer.encode(real)\n104\t# cue = a token that appears >=3 times\n105\tfrom collections import Counter\n106\tcnt=Counter(rtoks); cue=max([tk for tk,c in cnt.items() if c>=3], key=lambda tk:cnt[tk])\n107\tcue_str=model.tokenizer.decode([cue])\n108\trt=torch.tensor([model.tokenizer.bos_token_id]+rtoks,device=dev).unsqueeze(0); rseq=rt.shape[1]\n109\tcue_pos=[i for i,tk in enumerate([model.tokenizer.bos_token_id]+rtoks) if tk==cue]\n110\tprint(f\"\\nPART 2 — held-out real text. cue='{cue_str}' appears at {cue_pos}\",flush=True)\n111\trclean,rcache=model.run_with_cache(rt,names_filter=lambda n:n in\n112\t    [f\"blocks.{L}.hook_resid_pre\" for L in LAYERS]+[f\"blocks.{L}.attn.hook_attn_scores\" for L in LAYERS])\n113\trclean=rclean[0]\n114\t# FRA content-addressed on real text: ablate cue's induction pairs (computed from the induction seq pair-set\n115\t# for a cue-matched edge is hard cross-context; instead: ablate the induction-head score wherever\n116\t# query token == cue AND key is the position after a previous cue occurrence -> emulate by recomputing FRA on real text\n117\trfeats={L:saes[L].encode(rcache[f\"blocks.{L}.hook_resid_pre\"][0]).float() for L in LAYERS}\n118\tRFRA={}\n119\tfor (L,H) in IND_HEADS:\n120\t    fe=rfeats[L]; xh=fe@saes[L].W_dec.float()+saes[L].b_dec.float()\n121\t    r=_build_fra_result(model,L,H,fe,saes[L].W_dec.float(),dev,top_k=None,rms_activations=xh,dec_norms=None,chunk_size=16,verbose=False)\n122\t    f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n123\t    RFRA[(L,H)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n124\t# cue induction pairs on real text: query positions where token==cue, key = position right after a PRIOR cue\n125\tcue_edges=[]\n126\tfor qi in cue_pos:\n127\t    for ki in cue_pos:\n128\t        if ki+1<qi: cue_edges.append((qi,ki+1))  # attend back to token after an earlier cue\n129\t# build FRA delta on real text for these edges (top-M pairs each), apply with overdrive\n130\tdef real_fra_delta(c=8,M=12):\n131\t    byL={}\n132\t    for (L,H) in IND_HEADS:\n133\t        d=RFRA[(L,H)]; dd=np.zeros((rseq,rseq))\n134\t        for (qi,ki) in cue_edges:\n135\t            loc=np.where((d[\"qq\"]==qi)&(d[\"kk\"]==ki))[0]\n136\t            order=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:M]]\n137\t            for o in order: dd[qi,ki]+=d[\"vv\"][o]\n138\t        byL.setdefault(L,{})[H]=torch.tensor(dd,device=dev,dtype=torch.float32)*c\n139\t    return byL\n140\tbyL=real_fra_delta()\n141\thooks=[]\n142\tfor L,hd in byL.items():\n143\t    def mk(hd):\n144\t        def hook(s,hook):\n145\t            for H,sd in hd.items(): s[0,H,:rseq,:rseq]-=sd\n146\t            return s\n147\t        return hook\n148\t    hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(hd)))\n149\tr_fra=model.run_with_hooks(rt,fwd_hooks=hooks)[0]\n150\t# ActAdd content-addressed on real text: subtract cue dir wherever token==cue\n151\tvX=rcache[f\"blocks.{L0}.hook_resid_pre\"][0][cue_pos[0]]-rcache[f\"blocks.{L0}.hook_resid_pre\"][0].mean(0)\n152\tvX=vX/(vX.norm()+1e-6)\n153\tdef ahook(act,hook):\n154\t    for p in cue_pos: act[0,p,:]=act[0,p,:]-2.0*vX*act[0,p,:].norm()\n155\t    return act\n156\tr_aa=model.run_with_hooks(rt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",ahook)])[0]\n157\tklf=kl_full(rclean,r_fra); kla=kl_full(rclean,r_aa)\n158\tprint(f\"  FRA   : total real-text KL {klf.sum().item():.3f}  (mean/pos {klf.mean().item():.4f})\",flush=True)\n159\tprint(f\"  ActAdd: total real-text KL {kla.sum().item():.3f}  (mean/pos {kla.mean().item():.4f})\",flush=True)\n160\tprint(f\"  KL at cue positions: FRA {klf[cue_pos].mean().item():.4f}  ActAdd {kla[cue_pos].mean().item():.4f}\",flush=True)\n161\t\n162\tout={\"part1\":{\"fra_supp\":float(np.mean(fra_supp)),\"aa_supp\":float(np.mean(aa_supp)),\n163\t              \"fra_offtarget_kl\":float(np.mean(fra_off)),\"aa_offtarget_kl\":float(np.mean(aa_off)),\n164\t              \"ratio\":float(np.mean(aa_off)/max(np.mean(fra_off),1e-4))},\n165\t     \"part2\":{\"cue\":cue_str,\"fra_total_kl\":float(klf.sum().item()),\"aa_total_kl\":float(kla.sum().item()),\n166\t              \"fra_cue_kl\":float(klf[cue_pos].mean().item()),\"aa_cue_kl\":float(kla[cue_pos].mean().item())}}\n167\tjson.dump(out,open(os.path.join(OUT,\"j5.json\"),\"w\"),indent=2)\n168\tfig,ax=plt.subplots(1,2,figsize=(9,4))\n169\tax[0].bar([\"FRA-QK\",\"ActAdd-cue\"],[np.mean(fra_off),np.mean(aa_off)],color=['C0','C1'])\n170\tax[0].set_title(f\"off-target collateral on induction seq\\n(matched suppression ~{np.mean(fra_supp):.0%})\"); ax[0].set_ylabel(\"off-target KL mass (nats)\")\n171\tax[1].bar([\"FRA-QK\",\"ActAdd-cue\"],[klf.sum().item(),kla.sum().item()],color=['C0','C1'])\n172\tax[1].set_title(f\"held-out real-text collateral\\n(cue='{cue_str.strip()}')\"); ax[1].set_ylabel(\"total KL vs clean (nats)\")\n173\tplt.tight_layout(); plt.savefig(os.path.join(OUT,\"j5_collateral.png\"),dpi=110)\n174\tprint(\"\\nDONE j5\",flush=True)\n175\t"}]},"uuid":"46435761-d3a1-4b5e-90a8-ce71c111e9b5","timestamp":"2026-06-10T08:20:38.805Z","sourceToolAssistantUUID":"0e8e3711-5217-4918-92be-b066ad970b1f","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"46435761-d3a1-4b5e-90a8-ce71c111e9b5","isSidechain":true,"agentId":"a0186935e26cce807","message":{"model":"claude-opus-4-8","id":"msg_013NtbVLYdX66fvm14WUkHEJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JKbk1VoDQRhZCt9qX22sgK","name":"Read","input":{"file_path":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win/jobs/j7_keyside.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":813,"cache_creation_input_tokens":17103,"cache_read_input_tokens":10607,"cache_creation":{"ephemeral_5m_input_tokens":17103,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CbuFeksKV6jGhHLcftqsF","attributionAgent":"general-purpose","type":"assistant","uuid":"53de4884-63e6-4cfd-a2e8-221e360a90b0","timestamp":"2026-06-10T08:20:39.734Z","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"53de4884-63e6-4cfd-a2e8-221e360a90b0","isSidechain":true,"promptId":"99f21099-1bdf-4e90-9d41-1443256357f6","agentId":"a0186935e26cce807","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKbk1VoDQRhZCt9qX22sgK","type":"tool_result","content":"1\t\"\"\"J7 — harden the win against the two obvious objections:\n2\t(1) strongest LINEAR baseline: ActAdd of the KEY-side 'prev-was-cue' direction (most induction-specific\n3\t    linear steer) — does it escape the collateral that cue-identity ActAdd pays? It shouldn't: still\n4\t    single-endpoint-gated (fires wherever prev-token==cue), so collateral on all post-cue positions.\n5\t(2) split held-out KL by position type: NON-induction cue positions (pure collateral) vs induction\n6\t    positions (intended). FRA should be ~0 at non-induction positions; ActAdd corrupts them.\n7\tHeld-out text has the cue THREE times (1st = non-induction; later = induction-like).\n8\t\"\"\"\n9\timport os, sys, json\n10\tsys.path.insert(0,\"/workspace/code\")\n11\timport torch, numpy as np\n12\timport matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n13\tfrom transformer_lens import HookedTransformer\n14\tfrom sae_lens import SAE\n15\tfrom fra.core.fra import _build_fra_result\n16\t\n17\tOUT=os.environ.get(\"OUTDIR\",\".\"); dev=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n18\ttorch.set_grad_enabled(False)\n19\tmodel=HookedTransformer.from_pretrained(\"gpt2\",device=dev); model.eval()\n20\tIND_HEADS=[(5,5),(6,9),(5,1),(7,10),(7,2)]; LAYERS=sorted(set(L for L,H in IND_HEADS)); L0=min(LAYERS)\n21\ttok=model.tokenizer\n22\tsaes={L:(SAE.from_pretrained(\"gpt2-small-res-jb\",f\"blocks.{L}.hook_resid_pre\",device=dev)) for L in LAYERS}\n23\tsaes={L:(s[0] if isinstance(s,tuple) else s) for L,s in saes.items()}\n24\t\n25\tdef fra_per_head(tt):\n26\t    names=[f\"blocks.{L}.hook_resid_pre\" for L in LAYERS]\n27\t    _,cache=model.run_with_cache(tt,names_filter=lambda n:n in names)\n28\t    H={}; resid={L:cache[f\"blocks.{L}.hook_resid_pre\"][0] for L in LAYERS}\n29\t    for (L,Hh) in IND_HEADS:\n30\t        fe=saes[L].encode(cache[f\"blocks.{L}.hook_resid_pre\"][0]).float()\n31\t        xh=fe@saes[L].W_dec.float()+saes[L].b_dec.float()\n32\t        r=_build_fra_result(model,L,Hh,fe,saes[L].W_dec.float(),dev,top_k=None,rms_activations=xh,dec_norms=None,chunk_size=16,verbose=False)\n33\t        f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n34\t        H[(L,Hh)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n35\t    return H,resid\n36\tdef fra_delta(HF,edges,seq,M=12):\n37\t    byL={}\n38\t    for (L,Hh) in IND_HEADS:\n39\t        d=HF[(L,Hh)]; dd=np.zeros((seq,seq))\n40\t        for (qi,ki) in edges:\n41\t            loc=np.where((d[\"qq\"]==qi)&(d[\"kk\"]==ki))[0]\n42\t            order=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:M]]\n43\t            for o in order: dd[qi,ki]+=d[\"vv\"][o]\n44\t        byL.setdefault(L,{})[Hh]=dd\n45\t    return byL\n46\tdef run_fra(tt,byL,c):\n47\t    seq=tt.shape[1]; hooks=[]\n48\t    for L,hd in byL.items():\n49\t        td={Hh:torch.tensor(dd,device=dev,dtype=torch.float32)*c for Hh,dd in hd.items()}\n50\t        def mk(td):\n51\t            def hook(s,hook):\n52\t                for Hh,sd in td.items(): s[0,Hh,:seq,:seq]-=sd\n53\t                return s\n54\t            return hook\n55\t        hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(td)))\n56\t    return model.run_with_hooks(tt,fwd_hooks=hooks)[0]\n57\tdef run_actadd(tt,positions,vX,s):\n58\t    def hook(act,hook):\n59\t        for p in positions: act[0,p,:]=act[0,p,:]-s*vX*act[0,p,:].norm()\n60\t        return act\n61\t    return model.run_with_hooks(tt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",hook)])[0]\n62\tdef klvec(p,q):\n63\t    lp=torch.log_softmax(p.float(),-1); lq=torch.log_softmax(q.float(),-1)\n64\t    return (lp.exp()*(lp-lq)).sum(-1)\n65\t\n66\tCUES=[\" war\",\" city\",\" water\",\" money\",\" market\"]\n67\ttorch.manual_seed(0); rows=[]\n68\tfor cw in CUES:\n69\t    cid=tok.encode(cw);\n70\t    if len(cid)!=1: continue\n71\t    cid=cid[0]; resp=tok.encode(\" then\")[0]\n72\t    N=20; R=(torch.randperm(40000)[:N]+1000).tolist(); R[10]=cid; R[11]=resp\n73\t    tt=torch.tensor([tok.bos_token_id]+R+R,device=dev).unsqueeze(0); seq=tt.shape[1]\n74\t    qpos=1+N+10; kpos=12; clean=model(tt)[0]; base=torch.softmax(clean[qpos].float(),-1)[resp].item()\n75\t    if base<0.3: continue\n76\t    HF,resid=fra_per_head(tt); byL=fra_delta(HF,[(qpos,kpos)],seq)\n77\t    vX=resid[L0][1+N+10]-resid[L0].mean(0); vX=vX/(vX.norm()+1e-6)            # cue-identity dir\n78\t    vKey=resid[L0][12]-resid[L0].mean(0); vKey=vKey/(vKey.norm()+1e-6)         # 'prev-was-cue' dir (pos after 1st cue)\n79\t    cue_pos_primer=[1+10,1+N+10]; key_pos_primer=[12,2+N+10]                   # positions after each cue\n80\t    # find strength for ~50% suppression for each method\n81\t    def supp_fra(c): return 1-torch.softmax(run_fra(tt,byL,c)[qpos].float(),-1)[resp].item()/base\n82\t    def supp_aa(positions,vv,s): return 1-torch.softmax(run_actadd(tt,positions,vv,s)[qpos].float(),-1)[resp].item()/base\n83\t    def find(fn,grid):\n84\t        best=None\n85\t        for x in grid:\n86\t            sp=fn(x)\n87\t            if best is None or abs(sp-0.5)<best[0]: best=(abs(sp-0.5),x,sp)\n88\t        return best[1],best[2]\n89\t    cF,sF=find(supp_fra,[1,2,4,8,16,32])\n90\t    sId,suId=find(lambda s:supp_aa(cue_pos_primer,vX,s),[0.25,0.5,1,2,4]);\n91\t    sKy,suKy=find(lambda s:supp_aa(key_pos_primer,vKey,s),[0.25,0.5,1,2,4,8])\n92\t    # held-out text: cue x3 (1st = non-induction, later = induction-like)\n93\t    htext=f\"A{cw} began.{cw} grew.{cw} mattered to people who watched it closely all year.\"\n94\t    hids=[tok.bos_token_id]+tok.encode(htext); ht=torch.tensor(hids,device=dev).unsqueeze(0); hseq=ht.shape[1]\n95\t    hcue=[i for i,t in enumerate(hids) if t==cid]\n96\t    if len(hcue)<2: continue\n97\t    nonind=[hcue[0]]; ind=hcue[1:]                       # 1st occ = non-induction collateral\n98\t    hclean=model(ht)[0]\n99\t    HFh,residh=fra_per_head(ht)\n100\t    hedges=[(qi,ki+1) for qi in hcue for ki in hcue if ki+1<qi]\n101\t    byLh=fra_delta(HFh,hedges,hseq) if hedges else {}\n102\t    vXh=residh[L0][hcue[0]]-residh[L0].mean(0); vXh=vXh/(vXh.norm()+1e-6)\n103\t    hkey=[i+1 for i in hcue if i+1<hseq]\n104\t    vKeyh=residh[L0][hcue[0]+1]-residh[L0].mean(0); vKeyh=vKeyh/(vKeyh.norm()+1e-6)\n105\t    kf=klvec(hclean, run_fra(ht,byLh,cF)) if byLh else torch.zeros(hseq)\n106\t    ki=klvec(hclean, run_actadd(ht,hcue,vXh,sId))\n107\t    kk=klvec(hclean, run_actadd(ht,hkey,vKeyh,sKy))\n108\t    def at(v,ps): return float(v[ps].mean().item()) if ps else 0.0\n109\t    row=dict(cue=cw,base=base,suppF=sF,suppId=suId,suppKy=suKy,\n110\t             FRA_nonind=at(kf,nonind),Id_nonind=at(ki,nonind),Ky_nonind=at(kk,nonind),\n111\t             FRA_total=float(kf.sum()),Id_total=float(ki.sum()),Ky_total=float(kk.sum()))\n112\t    rows.append(row)\n113\t    print(f\"cue '{cw}': supp F/Id/Ky={sF:.2f}/{suId:.2f}/{suKy:.2f} | \"\n114\t          f\"non-induction-pos KL  FRA {row['FRA_nonind']:.3f}  ActAdd-id {row['Id_nonind']:.3f}  ActAdd-key {row['Ky_nonind']:.3f}\",flush=True)\n115\t\n116\timport numpy as np\n117\tdef col(k): return np.array([r[k] for r in rows])\n118\tprint(f\"\\n=== n={len(rows)} cues, matched ~50% induction suppression ===\",flush=True)\n119\tprint(f\"COLLATERAL at NON-induction cue positions (pure collateral, want 0):\",flush=True)\n120\tprint(f\"  FRA-QK      : {col('FRA_nonind').mean():.3f} ± {col('FRA_nonind').std():.3f}\",flush=True)\n121\tprint(f\"  ActAdd-id   : {col('Id_nonind').mean():.3f} ± {col('Id_nonind').std():.3f}\",flush=True)\n122\tprint(f\"  ActAdd-key  : {col('Ky_nonind').mean():.3f} ± {col('Ky_nonind').std():.3f}\",flush=True)\n123\tjson.dump({\"rows\":rows,\"summary\":{k:[float(col(k).mean()),float(col(k).std())] for k in\n124\t          [\"FRA_nonind\",\"Id_nonind\",\"Ky_nonind\",\"FRA_total\",\"Id_total\",\"Ky_total\"]}},\n125\t          open(os.path.join(OUT,\"j7.json\"),\"w\"),indent=2)\n126\tplt.figure(figsize=(5.5,4))\n127\tlabels=[\"FRA-QK\\n(bilinear)\",\"ActAdd\\ncue-identity\",\"ActAdd\\nprev-was-cue\"]\n128\tvals=[col('FRA_nonind').mean(),col('Id_nonind').mean(),col('Ky_nonind').mean()]\n129\terrs=[col('FRA_nonind').std(),col('Id_nonind').std(),col('Ky_nonind').std()]\n130\tplt.bar(labels,vals,yerr=errs,color=['C0','C1','C2'])\n131\tplt.ylabel(\"collateral KL at non-induction cue positions (nats)\")\n132\tplt.title(f\"At matched 50% induction suppression (n={len(rows)} cues)\\nFRA leaves the cue untouched in non-induction contexts\")\n133\tplt.tight_layout(); plt.savefig(os.path.join(OUT,\"j7_keyside.png\"),dpi=120)\n134\tprint(\"\\nDONE j7\",flush=True)\n135\t"}]},"uuid":"0b9e4674-4c0f-41b4-8852-75015b81ab4d","timestamp":"2026-06-10T08:20:39.739Z","sourceToolAssistantUUID":"53de4884-63e6-4cfd-a2e8-221e360a90b0","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"0b9e4674-4c0f-41b4-8852-75015b81ab4d","isSidechain":true,"agentId":"a0186935e26cce807","message":{"model":"claude-opus-4-8","id":"msg_013NtbVLYdX66fvm14WUkHEJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HwGF6HktcU8hazypDxCBcF","name":"Read","input":{"file_path":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win/jobs/j8_pareto.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":813,"cache_creation_input_tokens":17103,"cache_read_input_tokens":10607,"cache_creation":{"ephemeral_5m_input_tokens":17103,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CbuFeksKV6jGhHLcftqsF","attributionAgent":"general-purpose","type":"assistant","uuid":"bc20d61f-8769-4560-b674-b5ba71425179","timestamp":"2026-06-10T08:20:39.942Z","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"bc20d61f-8769-4560-b674-b5ba71425179","isSidechain":true,"promptId":"99f21099-1bdf-4e90-9d41-1443256357f6","agentId":"a0186935e26cce807","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HwGF6HktcU8hazypDxCBcF","type":"tool_result","content":"1\t\"\"\"J8 — the definitive Pareto: induction suppression vs held-out collateral, three methods\n2\t(FRA-QK, ActAdd cue-identity, ActAdd key-side 'prev-was-cue'), multi-occurrence held-out text,\n3\taveraged over cues. Sidesteps suppression-matching by showing the whole curve.\n4\tFRA uses ALL feature-pairs on the target edge (not top-12) to push its suppression ceiling.\n5\t\"\"\"\n6\timport os, sys, json\n7\tsys.path.insert(0,\"/workspace/code\")\n8\timport torch, numpy as np\n9\timport matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n10\tfrom transformer_lens import HookedTransformer\n11\tfrom sae_lens import SAE\n12\tfrom fra.core.fra import _build_fra_result\n13\t\n14\tOUT=os.environ.get(\"OUTDIR\",\".\"); dev=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n15\ttorch.set_grad_enabled(False)\n16\tmodel=HookedTransformer.from_pretrained(\"gpt2\",device=dev); model.eval()\n17\tIND_HEADS=[(5,5),(6,9),(5,1),(7,10),(7,2)]; LAYERS=sorted(set(L for L,H in IND_HEADS)); L0=min(LAYERS)\n18\ttok=model.tokenizer\n19\tsaes={L:(SAE.from_pretrained(\"gpt2-small-res-jb\",f\"blocks.{L}.hook_resid_pre\",device=dev)) for L in LAYERS}\n20\tsaes={L:(s[0] if isinstance(s,tuple) else s) for L,s in saes.items()}\n21\tdef fra_ph(tt):\n22\t    _,cache=model.run_with_cache(tt,names_filter=lambda n:n in [f\"blocks.{L}.hook_resid_pre\" for L in LAYERS])\n23\t    H={}; resid={L:cache[f\"blocks.{L}.hook_resid_pre\"][0] for L in LAYERS}\n24\t    for (L,Hh) in IND_HEADS:\n25\t        fe=saes[L].encode(cache[f\"blocks.{L}.hook_resid_pre\"][0]).float(); xh=fe@saes[L].W_dec.float()+saes[L].b_dec.float()\n26\t        r=_build_fra_result(model,L,Hh,fe,saes[L].W_dec.float(),dev,top_k=None,rms_activations=xh,dec_norms=None,chunk_size=16,verbose=False)\n27\t        f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n28\t        H[(L,Hh)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n29\t    return H,resid\n30\tdef fra_delta(HF,edges,seq,M=None):\n31\t    byL={}\n32\t    for (L,Hh) in IND_HEADS:\n33\t        d=HF[(L,Hh)]; dd=np.zeros((seq,seq))\n34\t        for (qi,ki) in edges:\n35\t            loc=np.where((d[\"qq\"]==qi)&(d[\"kk\"]==ki))[0]\n36\t            if M is not None: loc=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:M]]\n37\t            for o in loc: dd[qi,ki]+=d[\"vv\"][o]\n38\t        byL.setdefault(L,{})[Hh]=dd\n39\t    return byL\n40\tdef run_fra(tt,byL,c):\n41\t    seq=tt.shape[1]; hooks=[]\n42\t    for L,hd in byL.items():\n43\t        td={Hh:torch.tensor(dd,device=dev,dtype=torch.float32)*c for Hh,dd in hd.items()}\n44\t        def mk(td):\n45\t            def hook(s,hook):\n46\t                for Hh,sd in td.items(): s[0,Hh,:seq,:seq]-=sd\n47\t                return s\n48\t            return hook\n49\t        hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(td)))\n50\t    return model.run_with_hooks(tt,fwd_hooks=hooks)[0]\n51\tdef run_aa(tt,positions,vX,s):\n52\t    def hook(act,hook):\n53\t        for p in positions:\n54\t            if p<tt.shape[1]: act[0,p,:]=act[0,p,:]-s*vX*act[0,p,:].norm()\n55\t        return act\n56\t    return model.run_with_hooks(tt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",hook)])[0]\n57\tdef kltot(p,q):\n58\t    lp=torch.log_softmax(p.float(),-1); lq=torch.log_softmax(q.float(),-1)\n59\t    return (lp.exp()*(lp-lq)).sum(-1).sum().item()\n60\t\n61\tCUES=[\" war\",\" city\",\" water\",\" money\",\" market\",\" music\",\" doctor\",\" river\"]\n62\tFC=[1,2,4,8,16,32,64]; AC=[0.25,0.5,1,2,4,8]\n63\ttorch.manual_seed(0)\n64\tagg={\"FRA\":[],\"Id\":[],\"Ky\":[]}; n=0\n65\tfor cw in CUES:\n66\t    cid=tok.encode(cw)\n67\t    if len(cid)!=1: continue\n68\t    cid=cid[0]; resp=tok.encode(\" then\")[0]\n69\t    N=20; R=(torch.randperm(40000)[:N]+1000).tolist(); R[10]=cid; R[11]=resp\n70\t    tt=torch.tensor([tok.bos_token_id]+R+R,device=dev).unsqueeze(0); seq=tt.shape[1]\n71\t    qpos=1+N+10; kpos=12; base=torch.softmax(model(tt)[0][qpos].float(),-1)[resp].item()\n72\t    if base<0.3: continue\n73\t    HF,resid=fra_ph(tt); byL=fra_delta(HF,[(qpos,kpos)],seq,M=None)\n74\t    vId=resid[L0][1+N+10]-resid[L0].mean(0); vId/=(vId.norm()+1e-6)\n75\t    vKy=resid[L0][12]-resid[L0].mean(0); vKy/=(vKy.norm()+1e-6)\n76\t    # held-out: cue x3\n77\t    htext=f\"A{cw} began.{cw} grew.{cw} mattered to people who watched it closely all year.\"\n78\t    hids=[tok.bos_token_id]+tok.encode(htext); ht=torch.tensor(hids,device=dev).unsqueeze(0); hseq=ht.shape[1]\n79\t    hcue=[i for i,t in enumerate(hids) if t==cid]\n80\t    if len(hcue)<2: continue\n81\t    hclean=model(ht)[0]; HFh,residh=fra_ph(ht)\n82\t    hedges=[(qi,ki+1) for qi in hcue for ki in hcue if ki+1<qi]\n83\t    byLh=fra_delta(HFh,hedges,hseq,M=None) if hedges else {}\n84\t    vIdh=residh[L0][hcue[0]]-residh[L0].mean(0); vIdh/=(vIdh.norm()+1e-6)\n85\t    hkey=[i+1 for i in hcue if i+1<hseq]\n86\t    vKyh=residh[L0][hcue[0]+1]-residh[L0].mean(0); vKyh/=(vKyh.norm()+1e-6)\n87\t    def supp(lg): return 1-torch.softmax(lg[qpos].float(),-1)[resp].item()/base\n88\t    cF=[(supp(run_fra(tt,byL,c)), kltot(hclean,run_fra(ht,byLh,c)) if byLh else 0.0) for c in FC]\n89\t    cI=[(supp(run_aa(tt,[1+10,1+N+10],vId,s)), kltot(hclean,run_aa(ht,hcue,vIdh,s))) for s in AC]\n90\t    cK=[(supp(run_aa(tt,[12,2+N+10],vKy,s)), kltot(hclean,run_aa(ht,hkey,vKyh,s))) for s in AC]\n91\t    agg[\"FRA\"].append(cF); agg[\"Id\"].append(cI); agg[\"Ky\"].append(cK); n+=1\n92\t    print(f\"cue '{cw}' base {base:.2f}: FRA max-supp {max(s for s,_ in cF):.2f}\",flush=True)\n93\t\n94\tdef collat_at(curves, target):\n95\t    out=[]\n96\t    for cur in curves:\n97\t        xs=[a for a,b in cur]; ys=[b for a,b in cur]\n98\t        if max(xs)<target: continue\n99\t        out.append(float(np.interp(target,xs,ys)))\n100\t    return np.array(out)\n101\tprint(f\"\\n=== n={n} cues — held-out collateral (nats) at matched suppression ===\",flush=True)\n102\tfor tgt in [0.3,0.5]:\n103\t    f=collat_at(agg[\"FRA\"],tgt); i=collat_at(agg[\"Id\"],tgt); k=collat_at(agg[\"Ky\"],tgt)\n104\t    print(f\"  supp={tgt}: FRA {f.mean():.3f}±{f.std():.3f} (n={len(f)}) | ActAdd-id {i.mean():.3f}±{i.std():.3f} | ActAdd-key {k.mean():.3f}±{k.std():.3f}\",flush=True)\n105\tjson.dump({\"n\":n,\"agg\":agg},open(os.path.join(OUT,\"j8.json\"),\"w\"),indent=2)\n106\t# money figure\n107\tplt.figure(figsize=(6.2,4.6))\n108\tfor key,lab,c in [(\"FRA\",\"FRA-QK (bilinear edit)\",\"C0\"),(\"Id\",\"ActAdd cue-identity (linear)\",\"C1\"),(\"Ky\",\"ActAdd prev-was-cue (linear)\",\"C2\")]:\n109\t    for cur in agg[key]:\n110\t        xs=[a for a,b in cur]; ys=[b for a,b in cur]; plt.plot(xs,ys,'-',color=c,alpha=0.25,lw=1)\n111\t    plt.plot([],[],'-',color=c,label=lab)\n112\tplt.yscale('symlog',linthresh=0.05)\n113\tplt.xlabel(\"induction suppression  (1 − P(resp)/base)  → stronger\"); plt.ylabel(\"held-out collateral  (KL on normal text, nats)  ↓ better\")\n114\tplt.title(f\"Suppress one token's induction association (n={n} cues)\\nFRA-QK stays surgical at every strength; linear steers wreck the cue\")\n115\tplt.legend(fontsize=8); plt.grid(alpha=0.2); plt.tight_layout(); plt.savefig(os.path.join(OUT,\"j8_pareto.png\"),dpi=130)\n116\tprint(\"\\nDONE j8\",flush=True)\n117\t"}]},"uuid":"6838afef-dcfa-464d-ae91-131e85317f39","timestamp":"2026-06-10T08:20:39.945Z","sourceToolAssistantUUID":"bc20d61f-8769-4560-b674-b5ba71425179","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
