n                    0.0\n                ],\n                [\n                    0.9985147065750201,\n                    0.0\n                ],\n                [\n                    0.9985220161406444,\n                    0.0\n                ],\n                [\n                    0.9985220184891369,\n                    0.0\n                ]\n            ],\n\n===== /tmp/fra_out/fra_win/out/j7/j7.json =====\n{\n    \"rows\": [\n        {\n            \"cue\": \" war\",\n            \"base\": 0.9775398969650269,\n            \"suppF\": 0.5267032239095661,\n            \"suppId\": 0.03871101176934855,\n            \"suppKy\": 0.3024375993802102,\n            \"FRA_nonind\": 0.0,\n            \"Id_nonind\": 0.715046226978302,\n            \"Ky_nonind\": 0.0,\n            \"FRA_total\": 0.12142151594161987,\n            \"Id_total\": 2.724306583404541,\n            \"Ky_total\": 2.0459394454956055\n        },\n        {\n            \"cue\": \" city\",\n            \"base\": 0.9989084005355835,\n            \"suppF\": 0.5936146353740837,\n            \"suppId\": 0.13742594831093347,\n            \"suppKy\": 0.23619148796263623,\n            \"FRA_nonind\": 0.0,\n            \"Id_nonind\": 0.5327319502830505,\n            \"Ky_nonind\": 0.0,\n            \"FRA_total\": 0.16589860618114471,\n            \"Id_total\": 2.986556053161621,\n            \"Ky_total\": 2.221785068511963\n        },\n        {\n            \"cue\": \" water\",\n            \"base\": 0.99140465259552,\n            \"suppF\": 0.41557469153207993,\n            \"suppId\": 0.598541995706129,\n            \"suppKy\": 0.3663098260627511,\n            \"FRA_nonind\": 0.0,\n            \"Id_nonind\": 0.5600465536117554,\n            \"Ky_nonind\": 0.0,\n            \"FRA_total\": 0.08155001699924469,\n            \"Id_total\": 1.6212489604949951,\n            \"Ky_total\": 2.5032713413238525\n        },\n        {\n            \"cue\": \" money\",\n            \"base\": 0.9653043746948242,\n            \"suppF\": 0.20970168791586596,\n            \"suppId\": 0.8552958391169686,\n            \"suppKy\": 0.5940718253399789,\n            \"FRA_nonind\": 0.0,\n            \"Id_nonind\": 1.1388658285140991,\n            \"Ky_nonind\": 0.0,\n            \"FRA_total\": 0.12920376658439636,\n            \"Id_total\": 2.0797431468963623,\n            \"Ky_total\": 2.0347254276275635\n        },\n        {\n            \"cue\": \" market\",\n            \"base\": 0.982998251914978,\n            \"suppF\": 0.6363965587139538,\n            \"suppId\": 0.5863322668347646,\n            \"suppKy\": 0.5477772096899983,\n            \"FRA_nonind\": 0.0,\n            \"Id_nonind\": 0.2999950051307678,\n            \"Ky_nonind\": 0.0,\n            \"FRA_total\": 0.20775237679481506,\n            \"Id_total\": 1.9800012111663818,\n            \"Ky_total\": 2.113830804824829\n        }\n    ],\n    \"summary\": {\n        \"FRA_nonind\": [\n            0.0,\n            0.0\n        ],\n        \"Id_nonind\": [\n            0.649337112903595,\n            0.27841175523721245\n        ],\n        \"Ky_nonind\": [\n            0.0,\n            0.0\n        ],\n        \"FRA_total\": [\n            0.14116525650024414,\n            0.04273746012241739\n        ],\n        \"Id_total\": [\n            2.2783711910247804,\n            0.5021297728253303\n        ],\n        \"Ky_total\": [\n            2.1839104175567625,\n            0.17299086177407227\n        ]\n    }\n}\n\n===== /tmp/fra_out/fra_win/out/j8/j8.json =====\n{\n    \"n\": 8,\n    \"agg\": {\n        \"FRA\": [\n            [\n                [\n                    0.32210053682843554,\n                    0.11832984536886215\n                ],\n                [\n                    0.8229347086576801,\n                    0.12195932865142822\n                ],\n                [\n                    0.8249673727430273,\n                    0.12197564542293549\n                ],\n                [\n                    0.8249673270124298,\n                    0.12197539955377579\n                ],\n                [\n                    0.8249673270124298,\n                    0.12197539955377579\n                ],\n                [\n                    0.8249673270124298,\n                    0.12197539955377579\n                ],\n                [\n                    0.8249673270124298,\n                    0.12197539955377579\n                ]\n            ],\n            [\n                [\n                    0.4531556422968521,\n                    0.1619456708431244\n                ],\n                [\n                    0.6354105716472356,\n                    0.1658777892589569\n                ],\n                [\n                    0.6364351912792378,\n                    0.16592887043952942\n                ],\n                [\n                    0.6364356686374799,\n                    0.1659294217824936\n                ],\n                [\n                    0.6364356686374799,\n                    0.1659294217824936\n                ],\n                [\n                    0.6364356686374799,\n                    0.1659294217824936\n                ],\n                [\n                    0.6364356686374799,\n                    0.1659294217824936\n                ]\n            ],\n            [\n                [\n                    0.9955042957498372,\n                    0.09338639676570892\n                ],\n                [\n                    0.9985092005342464,\n                    0.09638433903455734\n                ],\n                [\n                    0.998522020367931,\n                    0.09642340242862701\n                ],\n                [\n                    0.9985220184891369,\n                    0.09642297029495239\n                ],\n                [\n                    0.9985220184891369,\n                    0.09642297029495239\n                ],\n                [\n                    0.9985220184891369,\n                    0.09642297029495239\n                ],\n                [\n                    0.9985220184891369,\n                    0.09642297029495239\n                ]\n            ],\n            [\n                [\n                    0.8929921791255637,\n                    0.1568101942539215\n                ],\n                [\n                    0.9487112707408157,\n                    0.16761118173599243\n                ],\n                [\n                    0.9493697754323525,\n                    0.1676982343196869\n                ],\n                [\n                    0.9493712998113012,\n                    0.16769680380821228\n                ],\n                [\n                    0.9493712998113012,\n                    0.16769680380821228\n                ],\n                [\n                    0.9493712998113012,\n                    0.16769680380821228\n                ],\n                [","is_error":false}]},"uuid":"9d462f9f-aa82-4edc-931a-ab84f2d1393b","timestamp":"2026-06-10T08:20:53.568Z","sourceToolAssistantUUID":"990da910-b030-44c2-92b4-5fdd58a5f42c","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"82107c11-28b5-4d18-b1c5-e47b73f2c888","isSidechain":true,"promptId":"99f21099-1bdf-4e90-9d41-1443256357f6","agentId":"a0186935e26cce807","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AXEX5AqpVpVByASFcjx8QL","type":"tool_result","content":"1\t\"\"\"J4 — core win: selectively suppress ONE token's induction copying.\n2\tMethods aim to drop target token X's copy-prob while sparing other tokens:\n3\t  FRA-QK selective : ablate X's induction feature-pairs across all induction heads (over-drive c, sweep)\n4\t  ActAdd-X(query)  : subtract s * v_X (token-X identity dir) at X's query position, before induction layers (sweep s)\n5\t  random-pair      : FRA machinery but RANDOM pairs (null: should NOT suppress target)  [sanity]\n6\t  position-oracle  : zero the target edge scores across heads (selective, needs positions)\n7\t  head-ablate-all  : mean-ablate all induction heads (non-selective ref: kills all copying)\n8\tCollateral = mean |Δcopyprob| on the OTHER induction tokens (within-task selectivity).\n9\tWin = FRA reaches high target suppression at low collateral on a Pareto where ActAdd cannot.\n10\t\"\"\"\n11\timport os, sys, json\n12\tsys.path.insert(0,\"/workspace/code\")\n13\timport torch, numpy as np\n14\timport matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n15\tfrom transformer_lens import HookedTransformer\n16\tfrom sae_lens import SAE\n17\tfrom fra.core.fra import _build_fra_result\n18\t\n19\tOUT=os.environ.get(\"OUTDIR\",\".\"); dev=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n20\ttorch.set_grad_enabled(False)\n21\tmodel=HookedTransformer.from_pretrained(\"gpt2\",device=dev); model.eval()\n22\tIND_HEADS=[(5,5),(6,9),(5,1),(7,10),(7,2)]; LAYERS=sorted(set(L for L,H in IND_HEADS))\n23\tL0=min(LAYERS)\n24\ttorch.manual_seed(0); N=24\n25\tR=(torch.randperm(40000)[:N]+1000).tolist()\n26\ttoks=[model.tokenizer.bos_token_id]+R+R\n27\ttt=torch.tensor(toks,device=dev).unsqueeze(0); seq=tt.shape[1]\n28\tedges=[(1+N+t,t+2) for t in range(N-1)]; ind_targets={1+N+t:R[t+1] for t in range(N-1)}\n29\tnames=[f\"blocks.{L}.attn.hook_attn_scores\" for L in LAYERS]+[f\"blocks.{L}.hook_resid_pre\" for L in LAYERS]\n30\tlogits,cache=model.run_with_cache(tt,names_filter=lambda n:n in names)\n31\tdef cpvec(lg):\n32\t    p=torch.softmax(lg[0].float(),-1); return np.array([p[q,ind_targets[q]].item() for q,k in edges])\n33\tbase=cpvec(logits)\n34\tsaes={L:(SAE.from_pretrained(\"gpt2-small-res-jb\",f\"blocks.{L}.hook_resid_pre\",device=dev)) for L in LAYERS}\n35\tsaes={L:(s[0] if isinstance(s,tuple) else s) for L,s in saes.items()}\n36\tHFRA={}; rng=np.random.default_rng(0)\n37\tfor (L,H) in IND_HEADS:\n38\t    sae=saes[L]; act=cache[f\"blocks.{L}.hook_resid_pre\"][0]\n39\t    feats=sae.encode(act).float(); x_hat=feats@sae.W_dec.float()+sae.b_dec.float()\n40\t    r=_build_fra_result(model,L,H,feats,sae.W_dec.float(),dev,top_k=None,rms_activations=x_hat,dec_norms=None,chunk_size=16,verbose=False)\n41\t    f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n42\t    HFRA[(L,H)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n43\tSC={(L,H):cache[f\"blocks.{L}.attn.hook_attn_scores\"][0,H].float().cpu().numpy() for (L,H) in IND_HEADS}\n44\tresid={L:cache[f\"blocks.{L}.hook_resid_pre\"][0] for L in LAYERS}\n45\t\n46\tdef edge_pairs(LH,e,m):\n47\t    d=HFRA[LH]; loc=np.where((d[\"qq\"]==e[0])&(d[\"kk\"]==e[1]))[0]\n48\t    order=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:m]]\n49\t    return set((int(d[\"ii\"][o]),int(d[\"jj\"][o])) for o in order)\n50\tdef pairs_delta(LH,pset):\n51\t    d=HFRA[LH]; out=np.zeros((seq,seq))\n52\t    sel=[(int(d[\"ii\"][n]),int(d[\"jj\"][n])) in pset for n in range(len(d[\"vv\"]))]\n53\t    for n in np.where(sel)[0]: out[d[\"qq\"][n],d[\"kk\"][n]]+=d[\"vv\"][n]\n54\t    return out\n55\tdef score_patch(deltas,scale):\n56\t    byL={}\n57\t    for (L,H),dd in deltas.items(): byL.setdefault(L,{})[H]=torch.tensor(dd,device=dev,dtype=torch.float32)*scale\n58\t    hooks=[]\n59\t    for L,hd in byL.items():\n60\t        def mk(hd):\n61\t            def hook(s,hook):\n62\t                for H,sd in hd.items(): s[0,H,:seq,:seq]-=sd\n63\t                return s\n64\t            return hook\n65\t        hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(hd)))\n66\t    return cpvec(model.run_with_hooks(tt,fwd_hooks=hooks))\n67\t\n68\tM=12\n69\ttargets=[t for t in range(N-1) if base[t]>0.8][:8]\n70\tbase_t=float(np.mean([base[t] for t in targets]))\n71\tdef collat(v,t): return float(np.mean([abs(v[s]-base[s]) for s in range(N-1) if s!=t]))\n72\tprint(f\"targets {targets} base_t {base_t:.3f}\",flush=True)\n73\t\n74\t# precompute per-target FRA deltas + random-pair deltas\n75\tfra_deltas={}; rnd_deltas={}\n76\tall_pairs={}\n77\tfor LH in IND_HEADS:\n78\t    d=HFRA[LH]; all_pairs[LH]=list(set(zip(d[\"ii\"].tolist(),d[\"jj\"].tolist())))\n79\tfor t in targets:\n80\t    e=edges[t]\n81\t    fra_deltas[t]={LH:pairs_delta(LH,edge_pairs(LH,e,M)) for LH in IND_HEADS}\n82\t    rnd_deltas[t]={LH:pairs_delta(LH,set(tuple(all_pairs[LH][i]) for i in rng.choice(len(all_pairs[LH]),M,replace=False))) for LH in IND_HEADS}\n83\t\n84\t# ActAdd-X: subtract s*vX at query pos (2nd-X) at resid_pre L0 (propagates to all induction heads)\n85\tdef actadd(t,s):\n86\t    qpos=edges[t][0]\n87\t    vX=resid[L0][qpos]-resid[L0].mean(0); vX=vX/(vX.norm()+1e-6)\n88\t    def hook(act,hook):\n89\t        act[0,qpos,:]=act[0,qpos,:]-s*vX*act[0,qpos,:].norm()\n90\t        return act\n91\t    return cpvec(model.run_with_hooks(tt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",hook)]))\n92\t\n93\tCS=[1,2,4,8,16,32]; AS=[0.25,0.5,1,2,4,8]\n94\tdef curve(fn):  # returns list of (supp, collateral) over sweep\n95\t    pts=[]\n96\t    for x in (CS if fn=='fra' or fn=='rnd' else AS):\n97\t        tg=[]; co=[]\n98\t        for t in targets:\n99\t            if fn=='fra': v=score_patch(fra_deltas[t],x)\n100\t            elif fn=='rnd': v=score_patch(rnd_deltas[t],x)\n101\t            else: v=actadd(t,x)\n102\t            tg.append(v[t]); co.append(collat(v,t))\n103\t        pts.append((1-np.mean(tg)/base_t, float(np.mean(co)), x))\n104\t    return pts\n105\tfra_pts=curve('fra'); aa_pts=curve('aa'); rnd_pts=curve('rnd')\n106\tprint(\"\\nFRA (supp, collat, c):\", [(round(a,2),round(b,3),c) for a,b,c in fra_pts],flush=True)\n107\tprint(\"ActAdd-X (supp, collat, s):\", [(round(a,2),round(b,3),c) for a,b,c in aa_pts],flush=True)\n108\tprint(\"random-pair (supp, collat, c):\", [(round(a,2),round(b,3),c) for a,b,c in rnd_pts],flush=True)\n109\t\n110\t# oracle + headablate single points\n111\tor_tg=[]; or_co=[]\n112\tfor t in targets:\n113\t    dd={LH:(np.zeros((seq,seq))) for LH in IND_HEADS}\n114\t    for LH in IND_HEADS: dd[LH][edges[t]]=SC[LH][edges[t][0],edges[t][1]]+20\n115\t    v=score_patch(dd,1.0); or_tg.append(v[t]); or_co.append(collat(v,t))\n116\tor_pt=(1-np.mean(or_tg)/base_t, float(np.mean(or_co)))\n117\tdef killall():\n118\t    hooks=[]\n119\t    for L in LAYERS:\n120\t        Hs=[H for (LL,H) in IND_HEADS if LL==L]\n121\t        def mk(Hs):\n122\t            def hook(z,hook):\n123\t                for H in Hs: z[0,:,H,:]=z[0,:,H,:].mean(0,keepdim=True)\n124\t                return z\n125\t            return hook\n126\t        hooks.append((f\"blocks.{L}.attn.hook_z\",mk(Hs)))\n127\t    return cpvec(model.run_with_hooks(tt,fwd_hooks=hooks))\n128\tka=killall(); ka_pt=(1-np.mean([ka[t] for t in targets])/base_t, float(np.mean([collat(ka,t) for t in targets])))\n129\tprint(f\"oracle (supp,collat): {or_pt}\",flush=True)\n130\tprint(f\"head-ablate-all (supp,collat): {ka_pt}\",flush=True)\n131\t\n132\tout={\"base_t\":base_t,\"fra\":fra_pts,\"actadd\":aa_pts,\"random\":rnd_pts,\"oracle\":or_pt,\"headablate\":ka_pt}\n133\tjson.dump(out,open(os.path.join(OUT,\"j4.json\"),\"w\"),indent=2)\n134\tplt.figure(figsize=(6,4.5))\n135\tfor pts,lab,mk in [(fra_pts,\"FRA-QK selective\",\"o-\"),(aa_pts,\"ActAdd-X (linear)\",\"s-\"),(rnd_pts,\"random pairs (null)\",\"^:\")]:\n136\t    xs=[p[0] for p in pts]; ys=[p[1] for p in pts]; plt.plot(xs,ys,mk,label=lab)\n137\tplt.scatter([or_pt[0]],[or_pt[1]],c='green',marker='*',s=140,label=\"position oracle\")\n138\tplt.scatter([ka_pt[0]],[ka_pt[1]],c='red',marker='x',s=90,label=\"kill all heads (non-selective)\")\n139\tplt.xlabel(\"target-token copy suppression  (1 - cp/base)  → better\"); plt.ylabel(\"collateral |Δcp| on other tokens  ←better\")\n140\tplt.title(\"Selective induction suppression — FRA-QK vs baselines\\n(down-right = selective + strong)\")\n141\tplt.legend(fontsize=8); plt.tight_layout(); plt.savefig(os.path.join(OUT,\"j4_pareto.png\"),dpi=110)\n142\tprint(\"\\nDONE j4\",flush=True)\n143\t"}]},"uuid":"1f152e47-8a6d-4138-abd9-0b05902029ef","timestamp":"2026-06-10T08:20:53.599Z","sourceToolAssistantUUID":"82107c11-28b5-4d18-b1c5-e47b73f2c888","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
{"parentUuid":"371861d4-3050-4a07-83fd-b83696d26120","isSidechain":true,"promptId":"99f21099-1bdf-4e90-9d41-1443256357f6","agentId":"a0186935e26cce807","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GKBo9kz3Gui8nSA2FMpZit","type":"tool_result","content":"1\t\"\"\"J6 — robustness + the money Pareto. Unified real-cue design:\n2\tFor each cue WORD, build an induction primer where the cue is followed by a response token, repeated,\n3\tso the 2nd cue triggers induction -> response. Then sweep strength for FRA-QK and ActAdd-cue and plot\n4\t(induction suppression at the cue edge) vs (held-out collateral = KL on a normal sentence containing the cue).\n5\tAggregate over cues -> mean Pareto + headline collateral ratio at matched suppression.\n6\t\"\"\"\n7\timport os, sys, json\n8\tsys.path.insert(0,\"/workspace/code\")\n9\timport torch, numpy as np\n10\timport matplotlib; matplotlib.use(\"Agg\"); import matplotlib.pyplot as plt\n11\tfrom transformer_lens import HookedTransformer\n12\tfrom sae_lens import SAE\n13\tfrom fra.core.fra import _build_fra_result\n14\t\n15\tOUT=os.environ.get(\"OUTDIR\",\".\"); dev=\"cuda\" if torch.cuda.is_available() else \"cpu\"\n16\ttorch.set_grad_enabled(False)\n17\tmodel=HookedTransformer.from_pretrained(\"gpt2\",device=dev); model.eval()\n18\tIND_HEADS=[(5,5),(6,9),(5,1),(7,10),(7,2)]; LAYERS=sorted(set(L for L,H in IND_HEADS)); L0=min(LAYERS)\n19\ttok=model.tokenizer\n20\tsaes={L:(SAE.from_pretrained(\"gpt2-small-res-jb\",f\"blocks.{L}.hook_resid_pre\",device=dev)) for L in LAYERS}\n21\tsaes={L:(s[0] if isinstance(s,tuple) else s) for L,s in saes.items()}\n22\t\n23\tdef fra_per_head(tt, edges_of_interest):\n24\t    seq=tt.shape[1]\n25\t    names=[f\"blocks.{L}.hook_resid_pre\" for L in LAYERS]\n26\t    _,cache=model.run_with_cache(tt,names_filter=lambda n:n in names)\n27\t    H={}; resid={L:cache[f\"blocks.{L}.hook_resid_pre\"][0] for L in LAYERS}\n28\t    for (L,Hh) in IND_HEADS:\n29\t        fe=saes[L].encode(cache[f\"blocks.{L}.hook_resid_pre\"][0]).float()\n30\t        xh=fe@saes[L].W_dec.float()+saes[L].b_dec.float()\n31\t        r=_build_fra_result(model,L,Hh,fe,saes[L].W_dec.float(),dev,top_k=None,rms_activations=xh,dec_norms=None,chunk_size=16,verbose=False)\n32\t        f=r[\"fra_tensor_sparse\"].coalesce(); idx=f.indices().cpu().numpy(); v=f.values().cpu().numpy()\n33\t        H[(L,Hh)]=dict(qq=idx[0],kk=idx[1],ii=idx[2],jj=idx[3],vv=v)\n34\t    return H, resid\n35\t\n36\tdef fra_delta_for_edges(HF, edges, seq, M=12):\n37\t    byL={}\n38\t    for (L,Hh) in IND_HEADS:\n39\t        d=HF[(L,Hh)]; dd=np.zeros((seq,seq))\n40\t        for (qi,ki) in edges:\n41\t            loc=np.where((d[\"qq\"]==qi)&(d[\"kk\"]==ki))[0]\n42\t            order=loc[np.argsort(-np.abs(d[\"vv\"][loc]))[:M]]\n43\t            for o in order: dd[qi,ki]+=d[\"vv\"][o]\n44\t        byL.setdefault(L,{})[Hh]=dd\n45\t    return byL\n46\t\n47\tdef run_fra(tt, byL_base, c):\n48\t    seq=tt.shape[1]; hooks=[]\n49\t    for L,hd in byL_base.items():\n50\t        td={Hh:torch.tensor(dd,device=dev,dtype=torch.float32)*c for Hh,dd in hd.items()}\n51\t        def mk(td):\n52\t            def hook(s,hook):\n53\t                for Hh,sd in td.items(): s[0,Hh,:seq,:seq]-=sd\n54\t                return s\n55\t            return hook\n56\t        hooks.append((f\"blocks.{L}.attn.hook_attn_scores\",mk(td)))\n57\t    return model.run_with_hooks(tt,fwd_hooks=hooks)[0]\n58\t\n59\tdef run_actadd(tt, cue_positions, vX, s):\n60\t    def hook(act,hook):\n61\t        for p in cue_positions: act[0,p,:]=act[0,p,:]-s*vX*act[0,p,:].norm()\n62\t        return act\n63\t    return model.run_with_hooks(tt,fwd_hooks=[(f\"blocks.{L0}.hook_resid_pre\",hook)])[0]\n64\t\n65\t# cue words that exist as single GPT-2 tokens and recur in normal text\n66\tCUES=[\" war\",\" city\",\" water\",\" money\",\" music\",\" doctor\",\" river\",\" market\"]\n67\tCS=[2,4,8,16,32]; AS=[0.5,1,2,4,8]\n68\ttorch.manual_seed(0)\n69\tresults={}\n70\tfor cue_word in CUES:\n71\t    cid=tok.encode(cue_word)\n72\t    if len(cid)!=1: continue\n73\t    cid=cid[0]; resp=tok.encode(\" then\")[0]\n74\t    # induction primer: random tokens with cue->resp embedded, repeated\n75\t    N=20; R=(torch.randperm(40000)[:N]+1000).tolist(); R[10]=cid; R[11]=resp\n76\t    toks=[tok.bos_token_id]+R+R\n77\t    tt=torch.tensor(toks,device=dev).unsqueeze(0); seq=tt.shape[1]\n78\t    qpos=1+N+10; kpos=12  # 2nd cue attends to token after 1st cue (=resp at pos 12)\n79\t    clean=model(tt)[0]\n80\t    base_resp=torch.softmax(clean[qpos].float(),-1)[resp].item()\n81\t    if base_resp<0.2: continue   # need the model to actually do this induction\n82\t    HF,resid=fra_per_head(tt,[(qpos,kpos)])\n83\t    byL=fra_delta_for_edges(HF,[(qpos,kpos)],seq)\n84\t    cue_positions=[1+10,1+N+10]\n85\t    vX=resid[L0][1+N+10]-resid[L0].mean(0); vX=vX/(vX.norm()+1e-6)\n86\t    # held-out collateral sentence containing the cue in a normal context\n87\t    htext=f\"The{cue_word} was very important to many people who lived nearby.\"\n88\t    ht=torch.tensor([tok.bos_token_id]+tok.encode(htext),device=dev).unsqueeze(0); hseq=ht.shape[1]\n89\t    hclean=model(ht)[0]\n90\t    hcue_pos=[i for i,t in enumerate([tok.bos_token_id]+tok.encode(htext)) if t==cid]\n91\t    # held-out FRA: recompute FRA on held text, ablate cue induction-like edges (query=cue, key=after earlier cue)\n92\t    HFh,residh=fra_per_head(ht,[])\n93\t    hedges=[(qi,ki+1) for qi in hcue_pos for ki in hcue_pos if ki+1<qi]\n94\t    byLh=fra_delta_for_edges(HFh,hedges,hseq) if hedges else None\n95\t    vXh=residh[L0][hcue_pos[0]]-residh[L0].mean(0); vXh=vXh/(vXh.norm()+1e-6)\n96\t    def kl(p,q):\n97\t        lp=torch.log_softmax(p.float(),-1); lq=torch.log_softmax(q.float(),-1)\n98\t        return (lp.exp()*(lp-lq)).sum(-1).sum().item()\n99\t    fra_curve=[]; aa_curve=[]\n100\t    for c in CS:\n101\t        l=run_fra(tt,byL,c); supp=1-torch.softmax(l[qpos].float(),-1)[resp].item()/base_resp\n102\t        if byLh is not None: hl=run_fra(ht,byLh,c); col=kl(hclean,hl)\n103\t        else: col=0.0\n104\t        fra_curve.append((supp,col))\n105\t    for s in AS:\n106\t        l=run_actadd(tt,cue_positions,vX,s); supp=1-torch.softmax(l[qpos].float(),-1)[resp].item()/base_resp\n107\t        hl=run_actadd(ht,hcue_pos,vXh,s); col=kl(hclean,hl)\n108\t        aa_curve.append((supp,col))\n109\t    results[cue_word]={\"base_resp\":base_resp,\"fra\":fra_curve,\"actadd\":aa_curve}\n110\t    print(f\"cue '{cue_word}' base_resp {base_resp:.2f}\",flush=True)\n111\t    print(f\"  FRA   : {[(round(a,2),round(b,2)) for a,b in fra_curve]}\",flush=True)\n112\t    print(f\"  ActAdd: {[(round(a,2),round(b,2)) for a,b in aa_curve]}\",flush=True)\n113\t\n114\t# headline: collateral at matched suppression ~0.5 (interp each curve)\n115\tdef collat_at(curve, target=0.5):\n116\t    xs=[a for a,b in curve]; ys=[b for a,b in curve]\n117\t    if max(xs)<target: return ys[int(np.argmax(xs))]\n118\t    return float(np.interp(target, xs, ys))\n119\tfra_c=[collat_at(r[\"fra\"]) for r in results.values()]\n120\taa_c=[collat_at(r[\"actadd\"]) for r in results.values()]\n121\tprint(f\"\\n=== HEADLINE (n={len(results)} cues), held-out collateral at 50% induction suppression ===\",flush=True)\n122\tprint(f\"  FRA-QK : {np.mean(fra_c):.2f} ± {np.std(fra_c):.2f}\",flush=True)\n123\tprint(f\"  ActAdd : {np.mean(aa_c):.2f} ± {np.std(aa_c):.2f}\",flush=True)\n124\tprint(f\"  ratio  : {np.mean(aa_c)/max(np.mean(fra_c),1e-3):.0f}x lower collateral for FRA\",flush=True)\n125\tjson.dump({\"results\":results,\"headline\":{\"fra_collat\":float(np.mean(fra_c)),\"aa_collat\":float(np.mean(aa_c)),\n126\t          \"ratio\":float(np.mean(aa_c)/max(np.mean(fra_c),1e-3)),\"n\":len(results)}},\n127\t          open(os.path.join(OUT,\"j6.json\"),\"w\"),indent=2)\n128\t# money figure: mean Pareto\n129\tplt.figure(figsize=(6,4.5))\n130\tfor r in results.values():\n131\t    plt.plot([a for a,b in r[\"fra\"]],[b for a,b in r[\"fra\"]],'-',color='C0',alpha=0.3)\n132\t    plt.plot([a for a,b in r[\"actadd\"]],[b for a,b in r[\"actadd\"]],'-',color='C1',alpha=0.3)\n133\tplt.plot([],[],'C0-',label=\"FRA-QK (bilinear edit)\"); plt.plot([],[],'C1-',label=\"ActAdd-cue (linear)\")\n134\tplt.yscale('symlog'); plt.xlabel(\"induction suppression  (1 - P(resp)/base)  → more\"); plt.ylabel(\"held-out collateral  KL on normal text (nats)\")\n135\tplt.title(f\"Suppress one token's induction: collateral vs strength (n={len(results)} cues)\\nFRA stays surgical; linear steer wrecks the cue everywhere\")\n136\tplt.legend(); plt.tight_layout(); plt.savefig(os.path.join(OUT,\"j6_pareto.png\"),dpi=120)\n137\tprint(\"\\nDONE j6\",flush=True)\n138\t"}]},"uuid":"4f1a2258-0358-4ac0-bd66-cb1dfa259e86","timestamp":"2026-06-10T08:20:53.601Z","sourceToolAssistantUUID":"371861d4-3050-4a07-83fd-b83696d26120","userType":"external","entrypoint":"cli","cwd":"/Users/dmitrymanning-coe/Documents/Research/FRA/fra_proj/experiments/fra_win","sessionId":"8a660228-bde0-4e60-bfe2-aafb33fe0b4d","version":"2.1.170","gitBranch":"autoresearch/fra-behavioral-win","slug":"moonlit-churning-gem"}
