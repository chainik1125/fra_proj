\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The QK side, verified on the mixture toy. Left: concept damage from the key-side FRA-QK cut falls $13$--$20\times $ from early to late positions --- aggregation protection tightening exactly as the drift bound prescribes. Right: the first-order covariance formula's error grows linearly in $c$ (remainder $\propto c^2$) and the $\tfrac  {c^2}{8}\operatorname  {osc}^2 D_v$ bound is never violated on any row.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:qkprotection}{{2}{8}{The QK side, verified on the mixture toy. Left: concept damage from the key-side FRA-QK cut falls $13$--$20\times $ from early to late positions --- aggregation protection tightening exactly as the drift bound prescribes. Right: the first-order covariance formula's error grows linearly in $c$ (remainder $\propto c^2$) and the $\tfrac {c^2}{8}\osc ^2 D_v$ bound is never violated on any row}{figure.2}{}}
